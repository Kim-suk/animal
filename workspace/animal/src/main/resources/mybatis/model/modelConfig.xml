<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration> <!-- 이 태그는 MyBatis 설정 파일의 루트 요소 -->
	<typeAliases>
		<typeAlias type="com.test.animal.member.dto.MemberDTO" alias="memberDTO"/>
	<typeAlias type="com.test.animal.board.dto.ArticleDTO" alias="articleDTO"/>
		<typeAlias type="com.test.animal.board.dto.ImageDTO" alias="imageDTO" />
		<!-- alias 는 간단히 말해 하나의 변수명 -->
	</typeAliases>
</configuration>	
<!-- MyBatis의 XML 매핑 파일 -->