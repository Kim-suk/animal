<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:mvc="http://www.springframework.org/schema/mvc"
	xsi:schemaLocation="http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc-3.1.xsd
		http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-3.1.xsd">

	<!-- 어노테이션을 사용할 수 있게 해주는 설정
	(@Controller, @RequestMapping, @ResponseBody, @Valid)-->
	<mvc:annotation-driven />

	<!-- "/resources/"아래의 모든 파일을 직접적으로 요청 가능 -->
	<mvc:resources mapping="/resources/**" location="/resources/" />

 	<mvc:resources mapping="/upload/**"
      location="file:/C:/springframework/workspace/animal/upload/" />
	
		<!-- Tiles를 사용하면 JSP의 공통 레이아웃을 효율적으로 관리 -->
		<!--  Tiles를 사용하기 위한 설정 객체 생성 -->
	<bean id="tilesConfigurer" class="org.springframework.web.servlet.view.tiles2.TilesConfigurer">
		<!-- TilesConfigurer는 Tiles 관련 설정을 로드하고 사용하도록 도와줌. -->
		<property name="definitions">
		<!-- definitions : Tiles XML 설정 파일을 지정 -->
			<list>
				<value>classpath:tiles/*.xml</value>
			</list>
		</property>
		<property name="preparerFactoryClass" value="org.springframework.web.servlet.view.tiles2.SpringBeanPreparerFactory" />
		<!-- SpringBeanPreparerFactory : Tiles에서 Spring의 Bean을 활용 가능 -->
	</bean>	
	

<!-- JSP를 위한 ViewResolver (Tiles에서 찾지 못할 경우 사용) -->


	
	<bean id="viewResolver" class="org.springframework.web.servlet.view.UrlBasedViewResolver">
	<!-- UrlBasedViewResolver :  JSP 파일이 아닌 Tiles 템플릿(XML 설정 파일)을 기반으로 뷰를 찾음. -->
		<property name="viewClass" value="org.springframework.web.servlet.view.tiles2.TilesView" />	
		<!-- TilesView: Tiles 레이아웃을 사용하기 위한 전용 뷰 리졸버(View Resolver) -->
	</bean>
		
	<context:component-scan base-package="com.test.animal" />
	<!-- context:component-scan : 
	 @Component, @Service, @Repository, @Controller 등의 어노테이션이 붙은 
	 클래스를 자동으로 Bean으로 등록하도록 하는 설정 -->
	
	<mvc:interceptors> <!-- interceptors :  컨트롤러(Controller) 실행 전/후에 특정 작업을 수행하는 기능 
										    컨트롤러 요청만 가로챔.
										    ✅ mvc:interceptors → 컨트롤러 실행 전후로 특정 기능을 수행하는 인터셉터를 설정
✅ preHandle() → 컨트롤러 실행 전에 수행됨 (로그인 체크 등)
✅ postHandle() → 컨트롤러 실행 후, 뷰 렌더링 전에 수행됨
✅ afterCompletion() → 뷰 렌더링 후 실행됨 (예외 처리 등)
✅ 로그 기록, 권한 검사, 인증 체크, 공통 데이터 설정 등에 유용함 🚀-->
		<mvc:interceptor>
			<mvc:mapping path="/*/*.do"/>
			<!--  /*.do 패턴을 가지는 모든 요청(URL)이 해당 인터셉터를 거치도록 설정.
					/member/login.do, /board/list.do 같은 요청 -->
			<bean class="com.test.animal.common.interceptor.ViewNameInterceptor" />
			<!-- 실제로 동작할 인터셉터 클래스 (ViewNameInterceptor)를 등록.
			 com.test.pro13.common.interceptor 패키지 안에 ViewNameInterceptor 클래스가 존재해야 함. -->
		</mvc:interceptor>
	</mvc:interceptors>
	
	<!-- multipartResolver : 파일 업로드를 처리하기 위한 설정 -->
		<bean id="multipartResolver" 
		class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
		<!-- CommonsMultipartResolver : 파일을 업로드할 때 크기 제한, 인코딩 등을 설정할 수 있음. -->
			<property name="maxUploadSize" value="52428800" />
			<property name="maxInMemorySize" value="1000000" />
			<property name="defaultEncoding" value="utf-8" />	
		</bean>
</beans>










