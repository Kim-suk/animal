<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.member">

    <resultMap type="memberDTO" id="memResult">
        <result property="id" column="id" />
        <result property="pwd" column="pwd" />
        <result property="age" column="age" />
        <result property="name" column="name" />
        <result property="gender" column="gender" />
        <result property="email" column="email" />
        <result property="joinDate" column="joinDate" />
        <result property="naverId" column="naver_id" />
        <result property="googleId" column="google_id" />
        <result property="kakaoId" column="kakao_id" />
        <result property="joinType" column="join_type" />
    </resultMap>

    <!-- 아이디 중복 체크 -->
    <select id="checkUserId" parameterType="String" resultType="int">
       <![CDATA[ SELECT COUNT(*) FROM animal_member WHERE id = #{id} ]]>
    </select>

    <!-- 전체 회원 리스트 -->
    <select id="listMembers" resultMap="memResult">
      <![CDATA[  SELECT * FROM animal_member ORDER BY joinDate DESC ]]>
    </select>

    <!-- 회원 상세 -->
    <select id="memberDetail" parameterType="String" resultType="memberDTO">
      <![CDATA[  SELECT * FROM animal_member WHERE id = #{id} ]]>
    </select>

    <!-- 회원 삭제 -->
    <delete id="delMember" parameterType="String">
      <![CDATA[  DELETE FROM animal_member WHERE id = #{id} ]]>
    </delete>

    <!-- 일반 회원 가입 -->
    <insert id="addMember" parameterType="memberDTO">
       <![CDATA[ INSERT INTO animal_member
            (id, pwd, age, name, gender, email, joinDate)
        VALUES
            (#{id}, #{pwd}, #{age, jdbcType=INTEGER}, #{name}, #{gender}, #{email}, SYSDATE) ]]>
    </insert>

    <!-- 회원 수정 -->
    <update id="modMember" parameterType="memberDTO">
      <![CDATA[  UPDATE animal_member
        SET pwd = #{pwd},
            age = #{age, jdbcType=INTEGER},
            name = #{name},
            gender = #{gender},
            email = #{email}
        WHERE id = #{id} ]]>
    </update>

    <!-- 로그인 -->
   <select id="login" parameterType="memberDTO" resultType="memberDTO">
		<![CDATA[
			select * from member where id=#{id} and pwd=#{pwd}
		]]>	
	</select>

    <!-- 네이버 사용자 조회 -->
    <select id="selectByNaverId" resultType="memberDTO">
      <![CDATA[  SELECT * FROM animal_member WHERE naver_id = #{naverId} ]]>
    </select>

    <!-- 구글 사용자 조회 -->
    <select id="selectByGoogleId" resultType="memberDTO">
      <![CDATA[  SELECT * FROM animal_member WHERE google_id = #{googleId} ]]>
    </select>

    <!-- 카카오 사용자 조회 -->
    <select id="selectByKakaoId" resultType="memberDTO">
       <![CDATA[ SELECT * FROM animal_member WHERE kakao_id = #{kakaoId} ]]>
    </select>

	<select id="findByEmail" parameterType="string" resultType="memberDTO">
   <![CDATA[  SELECT * FROM animal_member WHERE email = #{email}]]>
	</select>
	
	<select id="selectByEmail" parameterType="string" resultType="memberDTO">
   <![CDATA[  SELECT * FROM animal_member WHERE email = #{email, jdbcType=VARCHAR}]]>
	</select>
	
	<select id="selectByUserId" parameterType="string" resultType="memberDTO">
	   <![CDATA[ SELECT * FROM animal_member WHERE id = #{id} ]]>
	</select>
    <!-- 네이버 	사용자 삽입 -->
    <insert id="insertNaverUser" parameterType="memberDTO">
       <![CDATA[  INSERT INTO animal_member
            (id, pwd, name, email, naver_id, join_type, age, gender, joinDate)
        VALUES
             (#{id}, #{pwd}, #{name}, #{email}, #{naverId, jdbcType=VARCHAR}, #{joinType}, 0, 'U', SYSDATE) ]]>
    </insert>

    <!-- 구글 사용자 삽입 -->
    <insert id="insertGoogleUser" parameterType="memberDTO">
        <![CDATA[ INSERT INTO animal_member (
        id, pwd, name, email, gender, age, joinDate, google_id, join_type
    )
    VALUES (
        #{id}, #{pwd}, #{name}, #{email}, #{gender}, #{age}, SYSDATE, #{googleId, jdbcType=VARCHAR}, #{joinType}
    ) ]]>
    </insert>

    <!-- 카카오 사용자 삽입 -->
     <insert id="insertKakaoUser" parameterType="memberDTO">
       <![CDATA[  INSERT INTO animal_member
            (id, pwd, name, email, kakao_id, join_type, age, gender, joinDate)
        VALUES
             (#{id}, #{pwd}, #{name}, #{email, jdbcType=VARCHAR}, #{kakaoId, jdbcType=VARCHAR}, #{joinType}, 0, 'U', SYSDATE) ]]>
    </insert>

</mapper>
