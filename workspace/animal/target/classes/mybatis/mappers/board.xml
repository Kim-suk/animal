<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
        
        
<mapper namespace="mapper.board">
	<resultMap type="BoardDTO" id="boardResult">
		<result property="bno" column="bno" />
		<result property="id" column="id" />
		<result property="title" column="title" />
		<result property="content" column="content" />
		<result property="hashtag" column="hashtag" />
		<result property="writedate" column="writedate" />
		<result property="readcount" column="readcount" />
		<result property="img" column="img" />
		<result property="comment_count" column="comment_count" />
		<result property="like_it" column="like_it" />
	</resultMap>

	<select id="getboardList" parameterType="BoardDTO" resultMap="boardResult">
 	<![CDATA[  SELECT * FROM board ]]>
	</select>
	
	<insert id="insertboard" parameterType="BoardDTO">
		<![CDATA[
		INSERT INTO board (bno, title, id,content,hashtag,img)
		VALUES(board_seq.NEXTVAL,#{title},#{id},#{content},#{hashtag},#{img})
		]]>
	</insert>
	
</mapper>