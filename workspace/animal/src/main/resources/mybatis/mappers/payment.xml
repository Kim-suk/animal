    <insert id="insertPayment" parameterType="paymentDTO">
    INSERT INTO payment (paymentKey, orderId, member_id, amount)
    VALUES (#{paymentKey}, #{orderId}, #{memberId}, #{amount})
	</insert>

<select id="selectPaymentByOrderId" parameterType="string" resultType="paymentDTO">
    SELECT * FROM payment WHERE orderId = #{orderId}
</select>

