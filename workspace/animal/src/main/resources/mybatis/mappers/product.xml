<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.product">

    <resultMap type="productDTO" id="proResult">
        <result property="id" column="id" />
        <result property="name" column="name" />
        <result property="category" column="category" />
        <result property="description" column="description" />
        <result property="price" column="price" />
        <result property="image_url" column="image_url" />
    </resultMap>

    <!-- 제품 설명 -->
    <select id="productDetail" parameterType="String" resultType="productDTO">
      <![CDATA[
			SELECT name, category, description, price, image_url
				FROM product WHERE id = #{id}
		]]>	
    </select>
    
    <!-- 제품 전체 목록 불러오기 -->
	<select id="productList" resultMap="proResult">
   	 SELECT id, animal_type, name, category, description, price, image_url
   			 FROM product ORDER BY id ASC
	</select>
	
	<select id="getCatTop10" resultType="productDTO">
  <![CDATA[
    SELECT *
    FROM (
      SELECT *
      FROM product
      WHERE animal_type = '고양이'
      ORDER BY price DESC
    )
    WHERE ROWNUM <= 10
  ]]>
</select>

</mapper>
