<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.board">
	
	<!-- 게시글용 resultMap -->
	<resultMap type="boardDTO" id="boardResult">
		<result property="bno" column="bno" />
		<result property="category" column="category" />
		<result property="id" column="id" />
		<result property="title" column="title" />
		<result property="content" column="content" />
		<result property="hashtag" column="hashtag" />
		<result property="readcount" column="readcount" />
		<result property="img" column="img" />
		<result property="writedate" column="writedate" />
		<result property="comment_count" column="comment_count" />
		<result property="like_it" column="like_it" />
	</resultMap>

	<!-- 댓글용 resultMap -->
	<resultMap type="commentDTO" id="commentResult">
		<result property="comment_num" column="comment_num" />
		<result property="bno" column="bno" />
		<result property="id" column="id" />
		<result property="content" column="content" />
		<result property="writedate" column="writedate" />
	</resultMap>

	<!-- <mapper namespace="com.test.animal.board.dao.BoardDAO"> -->

	<!-- 게시글 목록 -->
    <select id="getBoardList" parameterType="boardDTO" resultType="boardDTO">
        SELECT * FROM board
        WHERE category = #{category}
        ORDER BY bno DESC
    </select>

    <!-- 게시글 상세 보기 -->
    <select id="getBoard" parameterType="boardDTO" resultType="boardDTO">
        SELECT * FROM board
        WHERE bno = #{bno}
    </select>

    <!-- 게시글 등록 (board_seq 사용) -->
    <insert id="insertBoard" parameterType="boardDTO">
        <selectKey keyProperty="bno" resultType="int" order="BEFORE">
            SELECT board_seq.NEXTVAL FROM dual
        </selectKey>
        INSERT INTO board (
            bno, category, id, title, content, hashtag,
            writedate, readcount, img, comment_count, like_it
        ) VALUES (
            #{bno}, #{category}, #{id}, #{title}, #{content}, #{hashtag},
            SYSDATE, 0, #{img}, 0, 0
        )
    </insert>

    <!-- 게시글 수정 -->
    <update id="updateBoard" parameterType="boardDTO">
        UPDATE board
        SET title = #{title},
            content = #{content},
            hashtag = #{hashtag},
            img = #{img}
        WHERE bno = #{bno}
    </update>

    <!-- 게시글 삭제 -->
    <delete id="deleteBoard" parameterType="boardDTO">
        DELETE FROM board
        WHERE bno = #{bno}
    </delete>

    <!-- 조회수 증가 -->
    <update id="updateReadCount" parameterType="int">
        UPDATE board
        SET readcount = readcount + 1
        WHERE bno = #{bno}
    </update>

    <!-- 댓글 목록 -->
    <select id="getComment" parameterType="int" resultType="commentDTO">
        SELECT * FROM board_comment
        WHERE bno = #{bno}
        ORDER BY comment_num ASC
    </select>

    <!-- 댓글 등록 및 댓글 수 증가 -->
    <insert id="insertComment" parameterType="commentDTO">
        <selectKey keyProperty="comment_num" resultType="int" order="BEFORE">
            SELECT NVL(MAX(comment_num), 0) + 1 FROM board_comment
        </selectKey>
        INSERT INTO board_comment (comment_num, bno, id, content, writedate)
        VALUES (#{comment_num}, #{bno}, #{id}, #{content}, SYSDATE);
        
        <!-- 댓글 수 증가 -->
        UPDATE board
        SET comment_count = comment_count + 1
        WHERE bno = #{bno}
    </insert>

    <!-- 좋아요 증가 -->
    <update id="updateLike" parameterType="int">
        UPDATE board
        SET like_it = like_it + 1
        WHERE bno = #{bno}
    </update>

    <!-- 좋아요 수 조회 -->
    <select id="selectLikeCount" parameterType="int" resultType="int">
        SELECT like_it FROM board
        WHERE bno = #{bno}
    </select>

</mapper>







