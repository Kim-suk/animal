<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.member">
	<resultMap type="memberDTO" id="memResult">
		<result property="id" column="id" />
		<result property="pwd" column="pwd" />
		<result property="age" column="age" />
		<result property="name" column="name" />
		<result property="gender" column="gender" />
		<result property="email" column="email" />
		<result property="joinDate" column="joinDate" />
		<result property="naverId" column="naverId" />
		<result property="googleId" column="googleId" />
		<result property="kakaoId" column="kakaoId" />
		<result property="joinType" column="joinType" />

	</resultMap>
	
	<!-- 아이디 중복 체크 쿼리 추가 -->
    <select id="checkUserId" parameterType="String" resultType="int">
        <![CDATA[
            SELECT COUNT(*) FROM animal_member WHERE id = #{id}
        ]]>
    </select>
    
	<select id="listMembers" resultMap="memResult">
		<![CDATA[
			select * from animal_member order by joinDate desc
		]]>
	</select>
	
	<select id="memberDetail" resultType="memberDTO" parameterType="String">
		<![CDATA[
			select * from animal_member where id=#{id}
		]]>
	</select>
	
	<delete id="delMember" parameterType="String">
		<![CDATA[
			delete from animal_member where id=#{id}
		]]>
	</delete>
	
	<insert id="addMember" parameterType="memberDTO">
		<![CDATA[

			 insert into animal_member (id, pwd, age, name, gender, email, joinDate)
            values (#{id}, #{pwd}, #{age, jdbcType=INTEGER}, #{name}, #{gender}, #{email}, 
            SYSDATE)

		]]>
	</insert>
	
	<update id="modMember" parameterType="memberDTO">
		<![CDATA[
		update animal_member 
            set pwd=#{pwd}, age=#{age, jdbcType=INTEGER}, name=#{name}, gender=#{gender}, email=#{email}
            where id=#{id}	
	]]>
	</update>
	
	<select id="login" parameterType="memberDTO" resultType="memberDTO">
		<![CDATA[
			select * from animal_member where id=#{id} and pwd=#{pwd}
		]]>	
	</select>
	
	
     <!-- 네이버 -->
    <select id="selectByNaverId" resultType="memberDTO">
        <![CDATA[
        SELECT * FROM ANIMAL_MEMBER WHERE NAVER_ID = #{naverId}
        ]]>
    </select>

    <!-- 구글 -->
    <select id="selectByGoogleId" resultType="memberDTO">
        <![CDATA[
        SELECT * FROM ANIMAL_MEMBER WHERE GOOGLE_ID = #{googleId}
        ]]>
    </select>

    <!-- 카카오 -->
    <select id="selectByKakaoId" resultType="memberDTO">
        <![CDATA[
        SELECT * FROM ANIMAL_MEMBER WHERE KAKAO_ID = #{kakaoId}
        ]]>
    </select>

    <!-- 소셜 사용자 삽입 -->
    <insert id="insertSocialUser" parameterType="memberDTO">
        <![CDATA[
        INSERT INTO ANIMAL_MEMBER
            (ID, NAME, EMAIL, NAVER_ID, GOOGLE_ID, KAKAO_ID, JOIN_TYPE)
        VALUES
            (#{id}, #{name}, #{email}, #{naverId}, #{googleId}, #{kakaoId}, #{joinType})
        ]]>
    </insert>
</mapper>