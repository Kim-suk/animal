<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.payment">

    <!-- 결제 정보 저장 -->
    <insert id="insertPayment" parameterType="paymentDTO">
      INSERT INTO payment (
        payment_id,
        member_id,
        total_amount,
        payment_date
      ) VALUES (
        payment_seq.NEXTVAL,  <!-- 시퀀스 사용 -->
        #{memberId},
        #{totalAmount}, 
        SYSDATE
      )
    </insert>

</mapper>